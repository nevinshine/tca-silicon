read_verilog -sv ibex/rtl/ibex_cs_registers.sv
read_verilog -sv ibex/rtl/ibex_csr.sv
read_verilog -sv ibex/rtl/ibex_decoder.sv
read_verilog -sv ibex/rtl/ibex_dummy_instr.sv
read_verilog -sv ibex/rtl/ibex_ex_block.sv
read_verilog -sv ibex/rtl/ibex_fetch_fifo.sv
read_verilog -sv ibex/rtl/ibex_icache.sv
read_verilog -sv ibex/rtl/ibex_id_stage.sv
read_verilog -sv ibex/rtl/ibex_if_stage.sv
